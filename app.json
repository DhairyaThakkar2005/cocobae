{
  "expo": {
    "name": "CocoBae POS",
    "slug": "cocobae",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7F7"
      },
      "package": "com.cocobae.pos",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F5A623"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CocoBae to access your photos to select dessert images.",
          "cameraPermission": "Allow CocoBae to access your camera to take dessert photos."
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "4cec3062-e41d-4213-a1b7-d9911b5048bb"
      }
    },
    "owner": "dhairya1"
  }
}
